{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "inventory-manager",
  "private": true,
  "version": "3.0.3",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "predev": "electron-rebuild -f -w better-sqlite3",
    "build": "vite build",
    "prebuild": "electron-rebuild -f -w better-sqlite3",
    "build:win": "vite build && electron-builder --win nsis --publish never",
    "prebuild:win": "electron-rebuild -f -w better-sqlite3",
    "build:linux": "vite build && electron-builder --linux AppImage --publish never",
    "prebuild:linux": "electron-rebuild -f -w better-sqlite3",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.4.1",
    "lucide-react": "^1.57.0",
    "nepali-date-converter": "^3.4.0",
    "ngrok": "^4.3.3",
    "pdfkit": "^0.20.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^7.18.0",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^38.8.6",
    "electron-builder": "^26.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12",
    "vite-plugin-electron": "^1.0.4",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "build": {
    "appId": "com.dipalitraders.inventorymanager",
    "productName": "Dipali Traders Inventory Manager",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/**/*",
      "src/Backend/**/*",
      "src/Database/.gitkeep"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "shortcutName": "Dipali Traders"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "extraResources": [
      {
        "from": "Invoice.docx",
        "to": "Invoice.docx"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ]
  }
}
